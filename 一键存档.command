#!/bin/bash
# ============================================================
# 学术工作台 · 一键存档（git 快照）
# 用法：双击本文件 → 输入一句本次改动说明（可留空）→ 回车
# 作用：把当前代码存成一个版本，以后可随时回退到任意存档点
# ============================================================
cd "$(dirname "$0")" || exit 1

echo "============================================"
echo "  学术工作台 · 一键存档"
echo "============================================"
echo ""
echo "【本次相对上一版的改动】"
git status --short
echo ""

# 没有任何改动就直接退出
if [ -z "$(git status --porcelain)" ]; then
  echo "没有需要存档的改动，工作区是干净的。"
  echo ""
  read -p "按回车键关闭..." _
  exit 0
fi

read -p "输入本次存档说明（直接回车则自动用时间）: " msg
if [ -z "$msg" ]; then
  msg="存档 $(date '+%Y-%m-%d %H:%M')"
fi

git add -A
git commit -m "$msg"
echo ""
echo "============================================"
echo "  存档完成！最近 6 个版本（最新在上）："
echo "============================================"
git log --oneline -6
echo ""
echo "提示：如果某次改坏了想退回，告诉我，我来帮你回退，不要自己乱敲命令。"
echo ""
read -p "按回车键关闭..." _
